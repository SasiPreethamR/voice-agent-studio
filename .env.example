# Copy to .env and fill in what you need. Every value is optional.
# Real environment variables override this file.

# local  (default): self-hosted GPU services; browsers may opt into Gemini per stage.
# gemini          : Gemini-only deployment, bring-your-own-key, no GPU packages needed.
# MODEL_PROVIDER=local

# Orchestrator listen port, and HTTPS=0 to ignore cert.pem/key.pem.
# PORT=8080
# HTTPS=auto

# Hugging Face token for gated models (Gemma 4, AI4Bharat Indic models).
HF_TOKEN=

# Gemini API key used when a browser picks Gemini in Model settings but does
# not supply its own key. Leave empty for strict bring-your-own-key.
GEMINI_API_KEY=

# Gemini model defaults shown in the UI.
# GEMINI_LLM_MODEL=gemini-3.8-flash
# GEMINI_STT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_REASONING_EFFORT=low

# Local service endpoints (defaults assume one host).
# STT_URL=http://localhost:8010
# LLM_URL=http://localhost:8003
# TTS_URL=http://localhost:8011
# INDIC_URL=http://localhost:7862
# LLM_MODEL=google/gemma-4-31B-it

# GPU placement for the start_*.sh scripts.
# LLM_GPUS=4,5
# TENSOR_PARALLEL_SIZE=2
# STT_GPU=7
# TTS_GPU=7
# INDIC_GPU=6

# Python interpreter used by the start scripts (default: /usr/bin/python3).
# PYTHON=/usr/bin/python3
